{
  "expo": {
    "name": "Mate Vision",
    "slug": "mate-vision-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#1a1a2e"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.matevision.app",
      "infoPlist": {
        "NSCameraUsageDescription": "This app needs camera access to capture images for detection",
        "NSPhotoLibraryUsageDescription": "This app needs photo library access to select images for detection"
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#1a1a2e"
      },
      "package": "com.matevision.app",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Mate Vision to access your camera for detection"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Mate Vision to access your photos for detection"
        }
      ],
      "expo-asset",
      "expo-font"
    ],
    "scheme": "matevision"
  }
}
